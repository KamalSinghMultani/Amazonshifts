# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Create a bot with @BotFather on Telegram -> gives you the token.
# Then message your new bot once, and visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your numeric chat id.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
