# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Create a bot with @BotFather on Telegram -> gives you the token.
# Then message your new bot once, and visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your numeric chat id.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OPTIONAL: automated re-login ────────────────────────────────────────────
# Only needed if you turn on session.auto_relogin in config.yaml.
#
# The trade: normally no code here ever reads your password — you log in by
# hand once. That is worth keeping if you can. But when a session dies at 3am,
# the watcher keeps detecting and alerting and cannot hold anything until you
# sit down and log in. Filling these in lets it try to sign itself back in.
#
# It attempts ONCE per expiry and stops if Amazon asks for a verification
# code, because repeated failed logins are how accounts get locked.
#
# .env is gitignored. Treat it like auth_state.json — it is your account.
AMAZON_LOGIN_EMAIL=
# The 6-digit PIN for your Amazon Hiring account (NOT your amazon.com
# shopping password — the hiring portal is a separate account).
AMAZON_LOGIN_PIN=
